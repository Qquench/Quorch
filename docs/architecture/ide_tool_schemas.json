  "dev_reviewer_cancel": {
    "description": "Deterministically cancel a running Reviewer task and abort transport.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "description": "Target job ID to cancel.",
          "type": "string"
        },
        "session_id": {
          "description": "Caller session ID for multi-session authorization.",
          "type": "string"
        },
        "workspace_root": {
          "description": "Root path of the target workspace.",
          "type": "string"
        }
      },
      "required": [
        "workspace_root",
        "job_id",
        "session_id"
      ],
      "type": "object"
    }
  },
  "dev_reviewer_poll": {
    "description": "Poll status or result of a background Reviewer task with 1KB snapshot contract.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "description": "Target job ID to poll.",
          "type": "string"
        },
        "session_id": {
          "description": "Caller session ID for multi-session authorization.",
          "type": "string"
        },
        "wait_max_s": {
          "default": 0,
          "description": "Server-side long polling wait timeout in seconds (0-25).",
          "type": "integer"
        },
        "workspace_root": {
          "description": "Root path of the target workspace.",
          "type": "string"
        }
      },
      "required": [
        "workspace_root",
        "job_id",
        "session_id"
      ],
      "type": "object"
    }
  },
  "dev_reviewer_submit": {
    "description": "Submit async review task.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "context_files": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Context files relative to workspace root."
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Client dedup key; same key returns cached job."
        },
        "max_hops": {
          "default": 1,
          "description": "Hop depth (0-3).",
          "type": "integer"
        },
        "mode": {
          "default": "evaluate",
          "description": "Mode ('critique', 'evaluate', 'audit').",
          "type": "string"
        },
        "query": {
          "description": "Review query content.",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional session UUID lock."
        },
        "workspace_root": {
          "description": "Project root path.",
          "type": "string"
        }
      },
      "required": [
        "workspace_root",
        "query"
      ],
      "type": "object"
    }
  },
  "dev_tasks_archive": {
