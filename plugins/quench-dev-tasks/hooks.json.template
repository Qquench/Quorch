{
  "quench-file-guard": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON_EXECUTABLE}}\" \"{{FILE_GUARD_SCRIPT_PATH}}\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "quench-context-injector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"{{PYTHON_EXECUTABLE}}\" \"{{CONTEXT_INJECTOR_SCRIPT_PATH}}\"",
        "timeout": 5
      }
    ]
  }
}
